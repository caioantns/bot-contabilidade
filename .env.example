# ---------- Banco ----------
# No Railway, use a variável de referência ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bot_contabilidade
# true só se conectar pela URL pública do Railway (fora da rede interna)
DATABASE_SSL=false

# ---------- IA (Claude) ----------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------- Embeddings (opcional) ----------
# Sem chave, a busca na base de conhecimento usa full-text do Postgres (funciona bem pra começar).
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# ---------- Canal do WhatsApp ----------
# evolution = QR code (Evolution API)  |  meta = WhatsApp Cloud API oficial
CANAL=evolution

# ---------- Evolution API (QR code) ----------
EVOLUTION_URL=https://sua-evolution.up.railway.app
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=contabilidade
# Segredo que vai na URL do webhook (invente um texto aleatório longo)
EVOLUTION_WEBHOOK_TOKEN=
# URL pública do bot. No Railway é preenchida sozinha; local, deixe vazio.
PUBLIC_URL=

# ---------- WhatsApp Cloud API (Meta) — só se CANAL=meta ----------
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Você inventa esse valor e coloca igual no painel da Meta ao configurar o webhook
WHATSAPP_VERIFY_TOKEN=troque-por-um-texto-aleatorio
# App Secret (Configurações do app > Básico). Valida que o webhook veio mesmo da Meta.
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v23.0

# ---------- Empresa ----------
EMPRESA_NOME=Contabilidade Exemplo
# Horário de atendimento humano (America/Sao_Paulo)
HORARIO_INICIO=8
HORARIO_FIM=18
# Dias úteis: 1=seg ... 5=sex
DIAS_UTEIS=1,2,3,4,5

# ---------- Painel/admin ----------
# Protege as rotas /admin (header: Authorization: Bearer <token>)
ADMIN_TOKEN=troque-isso

PORT=3000
